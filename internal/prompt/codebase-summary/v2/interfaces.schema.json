{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codebase-summary/v2/interfaces-fragment",
  "title": "component_fragment_interfaces",
  "type": "object",
  "additionalProperties": false,
  "required": ["complete", "items"],
  "properties": {
    "complete": { "type": "boolean" },
    "omitted_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "items": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "direction", "description", "source_paths"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "kind": {
            "type": "string",
            "enum": ["http_api", "rpc", "function", "method", "interface", "event", "command", "schema", "configuration", "other"]
          },
          "direction": { "type": "string", "enum": ["inbound", "outbound", "internal"] },
          "description": { "type": "string", "minLength": 1, "maxLength": 400 },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    }
  }
}

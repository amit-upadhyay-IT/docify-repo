{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codebase-summary/v2/diagrams-fragment",
  "title": "component_fragment_diagrams",
  "type": "object",
  "additionalProperties": false,
  "required": ["complete", "items"],
  "properties": {
    "complete": { "type": "boolean" },
    "omitted_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "items": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/flowchart" },
          { "$ref": "#/$defs/sequence" },
          { "$ref": "#/$defs/class_diagram" }
        ]
      }
    }
  },
  "$defs": {
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "flowchart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "nodes", "edges", "source_paths"],
      "properties": {
        "type": { "type": "string", "const": "flowchart" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "nodes": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 32 },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "label"],
            "properties": {
              "from": { "type": "string", "minLength": 1, "maxLength": 32 },
              "to": { "type": "string", "minLength": 1, "maxLength": 32 },
              "label": { "type": ["string", "null"], "maxLength": 80 }
            }
          }
        },
        "source_paths": { "$ref": "#/$defs/source_paths" }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "participants", "messages", "source_paths"],
      "properties": {
        "type": { "type": "string", "const": "sequence" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "participants": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 32 },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        },
        "messages": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "label", "response"],
            "properties": {
              "from": { "type": "string", "minLength": 1, "maxLength": 32 },
              "to": { "type": "string", "minLength": 1, "maxLength": 32 },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "response": { "type": "boolean" }
            }
          }
        },
        "source_paths": { "$ref": "#/$defs/source_paths" }
      }
    },
    "class_diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "classes", "relationships", "source_paths"],
      "properties": {
        "type": { "type": "string", "const": "class" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "classes": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "members"],
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 32 },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "members": {
                "type": "array",
                "maxItems": 3,
                "items": { "type": "string", "minLength": 1, "maxLength": 80 }
              }
            }
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "kind", "label"],
            "properties": {
              "from": { "type": "string", "minLength": 1, "maxLength": 32 },
              "to": { "type": "string", "minLength": 1, "maxLength": 32 },
              "kind": {
                "type": "string",
                "enum": ["association", "aggregation", "composition", "inheritance", "realization", "dependency"]
              },
              "label": { "type": ["string", "null"], "maxLength": 80 }
            }
          }
        },
        "source_paths": { "$ref": "#/$defs/source_paths" }
      }
    }
  }
}

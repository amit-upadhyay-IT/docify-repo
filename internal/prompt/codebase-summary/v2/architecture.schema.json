{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codebase-summary/v2/architecture-fragment",
  "title": "component_fragment_architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["complete", "items"],
  "properties": {
    "complete": { "type": "boolean" },
    "omitted_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "items": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "source_paths"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "minLength": 1, "maxLength": 400 },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    }
  }
}
